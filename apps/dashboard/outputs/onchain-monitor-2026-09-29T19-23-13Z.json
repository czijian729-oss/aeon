{
  "root": "card",
  "state": {},
  "elements": {
    "card": {
      "type": "Card",
      "props": {
        "title": "On-Chain Monitor",
        "description": "onchain-monitor::add-address"
      },
      "children": [
        "stack"
      ]
    },
    "stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "heading1",
        "badge1",
        "text1",
        "sep1",
        "heading2",
        "step1",
        "step2",
        "yaml",
        "text4",
        "sep2",
        "statsgrid",
        "alert1"
      ]
    },
    "heading1": {
      "type": "Heading",
      "props": {
        "text": "On-Chain Monitor — 还没有监听地址",
        "level": "h2"
      }
    },
    "badge1": {
      "type": "Badge",
      "props": {
        "text": "ON_CHAIN_NO_CONFIG",
        "variant": "destructive"
      }
    },
    "text1": {
      "type": "Text",
      "props": {
        "text": "监控列表仍是空的，这是第 8 次空跑（08-21 起每次都是 ON_CHAIN_NO_CONFIG）。之前 3 次 Telegram 提示（09-01 / 09-14 / 09-24）都没收到回复，所以这条路径可能压根到不了你手上。",
        "variant": "body"
      }
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "heading2": {
      "type": "Heading",
      "props": {
        "text": "想加监控，两种办法都行：",
        "level": "h3"
      }
    },
    "step1": {
      "type": "Text",
      "props": {
        "text": "1. 直接回复这条消息：0x…地址 base（链可选，默认 ethereum）",
        "variant": "body"
      }
    },
    "step2": {
      "type": "Text",
      "props": {
        "text": "2. 直接改配置：在 memory/on-chain-watches.yml 里写入",
        "variant": "body"
      }
    },
    "yaml": {
      "type": "Text",
      "props": {
        "text": "watches:\n  - label: \"AEON\"\n    address: \"0xbf8e8f0e8866a7052f948c16508644347c57aba3\"\n    chain: base\n    type: contract\n    threshold_usd: 200\n    event_topics:\n      - \"0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef\"",
        "variant": "muted"
      }
    },
    "text4": {
      "type": "Text",
      "props": {
        "text": "上面这段是你的 AEON 持仓（memory/MEMORY.md 里记录的那个 base 合约）。挂上去就能盯大额持仓变动。",
        "variant": "body"
      }
    },
    "sep2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "statsgrid": {
      "type": "Grid",
      "props": {
        "columns": 2,
        "gap": "md"
      },
      "children": [
        "stat1",
        "stat2"
      ]
    },
    "stat1": {
      "type": "Stat",
      "props": {
        "label": "AEON 当前报价",
        "value": "$1.785e-05"
      }
    },
    "stat2": {
      "type": "Stat",
      "props": {
        "label": "池子规模",
        "value": "~$41.8 万"
      }
    },
    "alert1": {
      "type": "Alert",
      "props": {
        "title": "⚠️ 一个真实约束",
        "message": "AEON 当前报价 $1.785e-05、池子只有 ~$41.8 万，所以 threshold_usd 要放低（比如 200）才会触发 —— 微盘的 ERC20 转账金额普遍很小。",
        "type": "warning"
      }
    }
  }
}
