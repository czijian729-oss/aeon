{
  "root": "card",
  "state": {},
  "elements": {
    "card": {
      "type": "Card",
      "props": {
        "title": "onchain-monitor",
        "description": "添加监控地址"
      },
      "children": [
        "heading",
        "alert",
        "chains-label",
        "chains"
      ]
    },
    "heading": {
      "type": "Heading",
      "props": {
        "text": "还没有监控地址",
        "level": "h3"
      }
    },
    "alert": {
      "type": "Alert",
      "props": {
        "type": "info",
        "message": "还没有监控地址。粘贴一个即可开始监控——0x… 钱包，可选加链名（如 base / ethereum / arbitrum）。"
      }
    },
    "chains-label": {
      "type": "Text",
      "props": {
        "text": "支持的链（可选）：",
        "variant": "muted"
      }
    },
    "chains": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm"
      },
      "children": [
        "chain-base",
        "chain-ethereum",
        "chain-arbitrum"
      ]
    },
    "chain-base": {
      "type": "Badge",
      "props": {
        "text": "base",
        "variant": "outline"
      }
    },
    "chain-ethereum": {
      "type": "Badge",
      "props": {
        "text": "ethereum",
        "variant": "outline"
      }
    },
    "chain-arbitrum": {
      "type": "Badge",
      "props": {
        "text": "arbitrum",
        "variant": "outline"
      }
    }
  }
}
